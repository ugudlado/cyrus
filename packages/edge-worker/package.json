{
	"name": "kittu-edge-worker",
	"version": "0.2.74",
	"description": "Unified edge worker for processing Linear issues with Claude",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyrusagents/cyrus.git",
		"directory": "packages/edge-worker"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"prompt-template-v2.md",
		"prompt-template.md",
		"label-prompt-template.md",
		"prompts"
	],
	"scripts": {
		"build": "tsgo && npm run copy-prompts",
		"copy-prompts": "cp label-prompt-template.md dist/ && cp -r prompts dist/ && rm -rf dist/kittu-skills-plugin && cp -rL kittu-skills-plugin dist/kittu-skills-plugin",
		"dev": "tsgo --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.281",
		"@linear/sdk": "^64.0.0",
		"@ngrok/ngrok": "^1.5.1",
		"chokidar": "^4.0.3",
		"kittu-claude-runner": "workspace:*",
		"kittu-cloudflare-tunnel-client": "workspace:*",
		"kittu-codex-runner": "workspace:*",
		"kittu-config-updater": "workspace:*",
		"kittu-core": "workspace:*",
		"kittu-cursor-runner": "workspace:*",
		"kittu-gemini-runner": "workspace:*",
		"kittu-github-event-transport": "workspace:*",
		"kittu-gitlab-event-transport": "workspace:*",
		"kittu-linear-event-transport": "workspace:*",
		"kittu-mcp-tools": "workspace:*",
		"kittu-opencode-runner": "workspace:*",
		"kittu-simple-agent-runner": "workspace:*",
		"kittu-slack-event-transport": "workspace:*",
		"kittu-zulip-event-transport": "workspace:*",
		"fastify": "^5.12.5",
		"fastify-mcp": "^2.1.0",
		"file-type": "^21.3.2",
		"ignore": "^7.0.5",
		"node-forge": "https://codeload.github.com/digitalbazaar/forge/tar.gz/ceba34402e329f0365134f23fe19898756527d65",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/node-forge": "^1.3.14",
		"@vitest/coverage-v8": "^4.1.11",
		"axios": "^1.20.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.11",
		"vitest-mock-extended": "^3.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
