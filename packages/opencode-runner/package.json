{
	"name": "kittu-opencode-runner",
	"version": "0.2.74",
	"description": "OpenCode CLI process wrapper for Kittu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyrusagents/cyrus.git",
		"directory": "packages/opencode-runner"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsgo",
		"dev": "tsgo --watch",
		"test": "vitest",
		"test:run": "vitest run --passWithNoTests",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"kittu-core": "workspace:*",
		"kittu-simple-agent-runner": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"access": "public"
	}
}
